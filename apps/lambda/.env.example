# ─── Flow keys for local runs ─────────────────────────────────────────────
# Copy this file to apps/lambda/.env and fill in the values. .env is ignored by
# git, so your keys never get committed. SANDBOX / TEST values only.
# Where to get each one: docs/KEYS.md
# Check them afterwards (prints ✓ or ✗, never the keys):
#   node apps/lambda/scripts/check-keys.js
#
# Leave a line empty to skip it. For ANTHROPIC_API_KEY, GOOGLE_API_KEY and
# REDIS_URL, an empty value means "use the one stored in AWS (SSM)", when there is one.

# ── AI: Claude does the thinking ─────────────────────────────────────────────
# console.anthropic.com → API Keys → Create Key (starts with sk-ant-).
# Needs prepaid credit (Plans & Billing). Without credit, Gemini answers instead.
ANTHROPIC_API_KEY=

# ── AI: Google Gemini searches documents, and is the backup for voice notes ──
# aistudio.google.com → API keys (starts with AIza). The free tier is enough now
# that Groq hears voice notes and Amazon Polly speaks.
GOOGLE_API_KEY=

# ── Voice notes → text: Groq's Whisper ──
# console.groq.com → API Keys → Create (starts with gsk_). Free plan, no card.
# Empty = Gemini transcribes instead.
GROQ_API_KEY=

# ── Spoken replies: Amazon Polly ─────────────────────────────────────────────
# No key: it uses your AWS login (the same as DynamoDB). Region with the Neural voices.
POLLY_REGION=us-east-1

# Which AI does the thinking. Empty = Claude when ANTHROPIC_API_KEY is set, else Gemini.
# anthropic | gemini
AI_PROVIDER=
# Optional model overrides (main provider only). Defaults: claude-haiku-5-5, backup claude-sonnet-5-5.
AI_MODEL=
AI_BACKUP_MODEL=
# Chat thinking effort: low (default; short replies and tool calls, fewest tokens), medium or high.
AI_EFFORT=

# ── PayPal sandbox: Flow's own app ────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → your app → Client ID + Secret.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Flow's own sandbox Business account: it owns the app, and the demo salon is
# paid into it, so payments, refunds, invoices and memberships all show up there.
# Testing Tools → Sandbox Accounts → that account → Account ID and its login email.
# In the app's Features, switch on Invoicing (and keep Subscriptions on).
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_PLATFORM_EMAIL=
# Webhook ID: only after deploying (the webhook needs a public URL). See DEPLOY.md.
PAYPAL_WEBHOOK_ID=
# Log in with PayPal for the demo customer. Optional:
# a separate sandbox app with "Log in with PayPal" ticked and Return URL
# http://127.0.0.1:4000/pay/paypal/login/return (PayPal won't save "localhost").
# Empty = the main app above. PAYPAL_LOGIN_RETURN_URL overrides the return URL.
PAYPAL_LOGIN_CLIENT_ID=
PAYPAL_LOGIN_CLIENT_SECRET=
PAYMENT_PROVIDER=paypal
DEFAULT_CURRENCY=USD

# ── PayPal sandbox: the demo salon ("Use the demo salon's PayPal") ──────────
# Optional: a second sandbox Business account playing Willow & Co. (scripts/seed-demo.js).
# Empty = the demo salon is paid into Flow's own account above.
DEMO_SALON_MERCHANT_ID=
DEMO_SALON_EMAIL=

# ── PayPal sandbox: the test buyer judges pay with ───────────────────────────
# A sandbox Personal account's login. Shown on the demo page on purpose (fake money).
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=

# ── Optional: seat holds ─────────────────────────────────────────────────────
# upstash.com → create a free Redis database → copy the rediss:// URL.
# Without it everything works; the 10-minute seat hold is just skipped.
REDIS_URL=

# ── Optional: Telegram ──────────────────────────
# Flow's demo bot: in Telegram, open @BotFather, send /newbot, paste the token.
# Locally the API long-polls it (no public URL needed). Stores connect their
# own bots from the Business side; those tokens are never put here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Deployed only: a random secret Telegram echoes back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=

# ── Optional: Alexa skill "Flow Bookings" ────────────────────────────────────
# The skill id from the Alexa developer console (amzn1.ask.skill.…). When set,
# only that skill may call Flow's alexa function.
ALEXA_SKILL_ID=
